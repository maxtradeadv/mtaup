{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"mtaup",
  "main":"./worker.ts",
  "compatibility_date":"2026-09-20",
  "assets":{
    "directory":"./",
    "binding":"ASSETS",
    "run_worker_first":true,
    "exclude":[
      ".git/**",
      ".wrangler/**",
      "worker.ts",
      "wrangler.jsonc",
      "*.md",
      "LICENSE",
      "NOTICE.md"
    ]
  },
  "keep_vars":true,
  "previews":{}
}